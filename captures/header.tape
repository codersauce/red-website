Set Shell "bash"
Set FontFamily "Berkeley Mono, Symbols Nerd Font Mono"
Set FontSize 20
Set LineHeight 1.25
Set Width 1600
Set Height 900
Set Padding 0
Set Margin 0
Set Framerate 30
Set TypingSpeed 55ms
Set CursorBlink false
Set Theme { "name": "red-capture", "background": "#101014", "foreground": "#D8D8DE", "cursor": "#D8D8DE", "selection": "#2A2A33", "black": "#101014", "red": "#FF5A5F", "green": "#8CC68C", "yellow": "#E8C07A", "blue": "#8FB8F0", "magenta": "#C9A0F0", "cyan": "#7FD1D1", "white": "#D8D8DE", "brightBlack": "#5A5A66", "brightRed": "#FF7A7E", "brightGreen": "#A6D8A6", "brightYellow": "#F0D29A", "brightBlue": "#A9C9F5", "brightMagenta": "#D8B8F5", "brightCyan": "#9FE0E0", "brightWhite": "#FFFFFF" }
Env XDG_CONFIG_HOME "/tmp/demo/xdg"
Env PS1 "\[\e[38;5;203m\]❯\[\e[0m\] "
Env BASH_SILENCE_DEPRECATION_WARNING "1"
Env GIT_AUTHOR_NAME "Demo"
Env GIT_AUTHOR_EMAIL "demo@getred.dev"
Env GIT_COMMITTER_NAME "Demo"
Env GIT_COMMITTER_EMAIL "demo@getred.dev"
