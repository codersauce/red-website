# Code explore: read a function without a model. Sidebar follows the cursor,
# follow a name, dim to the skeleton, jump to a definition and back on the trail.
Hide
Type "cd /tmp/demo/throttle && clear && red -c lsp.enabled=false src/bucket.rs"
Enter
Wait+Screen@30s /NORMAL/
Sleep 3s
Show
Sleep 1.2s
Space
Type "ee"
Sleep 1.8s
Space
Type "eR"
Sleep 1.6s
Type "/let earned"
Sleep 300ms
Enter
Type "w"
Sleep 1.8s
Space
Type "ef"
Sleep 2.2s
Type "/refill.Instant"
Sleep 300ms
Enter
Sleep 1.6s
Space
Type "es"
Sleep 2.6s
Space
Type "es"
Sleep 700ms
Space
Type "ed"
Sleep 2.2s
Space
Type "eb"
Sleep 2.6s
